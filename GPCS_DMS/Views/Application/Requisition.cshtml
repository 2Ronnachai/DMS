@{
    ViewData["Title"] = "Requisition";
}
@section Styles {
    <link rel="stylesheet" href="~/css/application/app-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/application/app-workflow.css" asp-append-version="true" />
    <style>
        .dx-datagrid-rowsview .dx-scrollable-container {
            margin-bottom: 12px !important;
        }
        /* Always render horizontal scrollbar in hover-expanded state */
        .dx-scrollbar-horizontal.dx-scrollbar-hoverable {
            height: 12px !important;
            background-color: rgba(191, 191, 191, 0.2) !important;
            transition: none !important;
        }

        .dx-scrollbar-horizontal.dx-scrollbar-hoverable .dx-scrollable-scroll {
            height: 12px !important;
            transition: none !important;
        }

        .dx-datagrid .dx-scrollable-scrollbars-alwaysvisible >
        .dx-scrollable-wrapper >
        .dx-scrollable-container >
        .dx-scrollable-content {
            padding-bottom: 0px !important;
        }
    </style>
}

<div class="container">
    <!-- Main Container -->
    <div id="applicationContainer">
        
        <!-- Top Action Buttons -->
        <div id="topActionButtons"></div>

        <!-- Header Section (Title + Info) -->
        <div id="headerSection"></div>
        
        <!-- Form Section (Master Data) -->
        <div id="formSection"></div>
        
        <!-- Items Section (Grid/Table) -->
        <div id="itemsSection"></div>

        <!-- Workflow Section -->
        <div id="workflowSection"></div>
        
        <!-- Bottom Action Buttons -->
        <div id="bottomActionButtons"></div>
        
    </div>
    
    <!-- Hidden Fields for Config -->
    <input type="hidden" id="applicationType" value="@ViewBag.ApplicationType" />
    <input type="hidden" id="applicationId" value="@ViewBag.ApplicationId" />
</div>


@section Scripts {
    <script src="~/js/application/validate/app-validation.js" asp-append-version="true"></script>
    <script src="~/js/application/app-header.popup.js" asp-append-version="true"></script>
    <script src="~/js/application/app-header.js" asp-append-version="true"></script>
    <script src="~/js/application/app-workflow.js" asp-append-version="true"></script>
    <script src="~/js/application/form/app-form.new-item.js" asp-append-version="true"></script>
    <script src="~/js/application/form/app-form.edit-item.js" asp-append-version="true"></script>
    <script src="~/js/application/form/app-form.delete-item.js" asp-append-version="true"></script>
    <script src="~/js/application/form/app-form.new-material-item.js" asp-append-version="true"></script>
    <script src="~/js/application/form/app-form.components.js" asp-append-version="true"></script>
    <script src="~/js/application/form/app-form.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.columns.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.config.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.toolbar.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.handler.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.new-item.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.new-material-item.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.edit-item.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.delete-item.js" asp-append-version="true"></script>
    <script src="~/js/application/grid/app-grid.js" asp-append-version="true"></script>
    <script src="~/js/application/app-button-handler.js" asp-append-version="true"></script>
    <script src="~/js/application/app-button.js" asp-append-version="true"></script>
    <script src="~/js/application/app-main.js" asp-append-version="true"></script>
    <script>
        function validateDocumentType(){
            var applicationType = document.getElementById("applicationType").value;
            if(!applicationType || applicationType.trim() === ""){
                alert("Application Type is required.");
                return false;
            }
            return applicationType;
        }

        function validateApplicationId(){
            var applicationId = document.getElementById("applicationId").value;
            return applicationId;
        }

        document.addEventListener("DOMContentLoaded", function() {
            var applicationType = validateDocumentType();
            var applicationId = validateApplicationId();
            if(applicationType){
                const app = new AppMain({
                    applicationType: applicationType,
                    applicationId: applicationId || null
                });

                // Expose appMain globally for debugging
                window.app = app;
            }
        });
    </script>
}