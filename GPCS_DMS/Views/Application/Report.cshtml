@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Application Report";
    Layout = "_LayoutPrint";
}
@section Styles {
    <link rel="stylesheet" href="~/css/report/application-report.css" />
}

<div class="container-fluid py-3">

    <!-- Toolbar -->
    <div class="rpt-toolbar">
        <div>
            <div class="rpt-toolbar-title">
                <i class="fa-solid fa-file-lines"></i>
                Application Report
            </div>
            <div class="rpt-toolbar-meta">GPCS &mdash; Data Maintenance System</div>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-sm rpt-btn">
                <i class="fa-solid fa-arrow-left me-1"></i> Back
            </a>
            <button class="btn btn-sm rpt-btn" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print / PDF
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div id="rptLoading">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Loading application data&hellip;</span>
    </div>

    <!-- Error -->
    <div id="rptError" class="alert alert-danger" style="border-radius:0">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        <span id="rptErrorMsg">Failed to load application data.</span>
    </div>

    <!-- Report Content -->
    <div id="rptContent" style="display:none">

        <!-- 01. Application Information -->
        <div class="card">
            <div class="card-body">
                <div class="rpt-section-title">
                    <i class="fa-solid fa-circle-info"></i>
                    Application Information
                </div>
                <div class="rpt-section-body">
                    <div id="rptAppInfo"></div>
                </div>
            </div>
        </div>

        <!-- 02. Materials / Items -->
        <div class="card" id="rptMaterialsCard">
            <div class="card-body">
                <div class="rpt-section-title">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    <span id="rptMaterialsSectionTitle">Materials</span>
                </div>
                <div class="rpt-section-body">
                    <div id="rptMaterialsNote" class="mb-2" style="display:none"></div>
                    <div class="table-print-wrap" style="overflow-x:auto">
                        <table class="rpt-table">
                            <thead id="rptMaterialsHead"></thead>
                            <tbody id="rptMaterialsBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 03. Workflow Progress -->
        <div class="card">
            <div class="card-body">
                <div class="rpt-section-title">
                    <i class="fa-solid fa-diagram-project"></i>
                    Workflow Progress
                </div>
                <div class="rpt-section-body">
                    <div id="rptWorkflow"></div>
                </div>
            </div>
        </div>

        <!-- 04. Action History -->
        <div class="card">
            <div class="card-body">
                <div class="rpt-section-title">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Action History
                </div>
                <div class="rpt-section-body">
                    <div class="table-print-wrap" style="overflow-x:auto">
                        <table class="rpt-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Step</th>
                                    <th>Action By</th>
                                    <th>Action</th>
                                    <th>Comments</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="rptHistoryBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 05. File Attachments -->
        <div class="card" id="rptFilesCard">
            <div class="card-body">
                <div class="rpt-section-title">
                    <i class="fa-solid fa-paperclip"></i>
                    File Attachments
                </div>
                <div class="rpt-section-body">
                    <div id="rptFilesList"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<input type="hidden" id="applicationType" value="@ViewBag.ApplicationType" />
<input type="hidden" id="applicationId"   value="@ViewBag.ApplicationId" />

@section Scripts {
    <script src="~/js/report/application-report.js"></script>
}
