@{
    ViewData["Title"] = "Application Report";
}
@section Styles {
    <link rel="stylesheet" href="~/css/grid.css" asp-append-version="true" />
    <style>
        /* ── Base reset ── */
        #workflowPopup,
        #workflowPopup * {
            box-sizing: border-box;
        }

        /* ── Overlay ── */
        .wf-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(2px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 24px;
        }

        /* ── Card ── */
        .wf-card {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", sans-serif;
            background: #ffffff;
            border-radius: 2px;
            width: 100%;
            max-width: 640px;
            max-height: calc(100vh - 48px);
            overflow-y: auto;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-color);
            position: relative;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.2s ease, transform 0.2s ease;
            padding: 28px 32px;
        }

        .wf-card--visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ── Close button ── */
        .wf-close-btn {
            position: absolute;
            top: 14px;
            right: 14px;
            width: 28px;
            height: 28px;
            border: 1px solid var(--border-color);
            border-radius: 2px;
            background: #ffffff;
            font-size: 18px;
            line-height: 1;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s, color 0.15s;
        }

        .wf-close-btn:hover {
            background: var(--bg-light);
            color: var(--text-primary);
        }

        /* ── Section ── */
        .wf-section {
            margin-bottom: 24px;
        }

        .wf-section:last-child {
            margin-bottom: 0;
        }

        .wf-section-title {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--text-secondary);
            margin-bottom: 10px;
        }

        /* ── Application Info ── */
        .wf-app-number {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 10px;
            line-height: 1.3;
        }

        .wf-app-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .wf-tag {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.04em;
            padding: 3px 10px;
            border-radius: 2px;
            border: 1px solid;
        }

        .wf-tag--success {
            color: var(--success-color);
            border-color: var(--success-color);
            background: #f0fdf4;
        }

        .wf-tag--danger {
            color: var(--danger-color);
            border-color: var(--danger-color);
            background: #fef2f2;
        }

        .wf-tag--info {
            color: var(--accent-color);
            border-color: var(--accent-color);
            background: #eff6ff;
        }

        .wf-tag--warning {
            color: var(--warning-color);
            border-color: var(--warning-color);
            background: #fffbe6;
        }

        .wf-tag--neutral {
            color: var(--text-secondary);
            border-color: var(--border-color);
            background: var(--bg-light);
        }

        /* ── Summary Stats ── */
        .wf-stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            border: 1px solid var(--border-color);
            border-radius: 2px;
            overflow: hidden;
        }

        .wf-stat-card {
            background: #ffffff;
            padding: 12px 14px;
            border-right: 1px solid var(--border-color);
        }

        .wf-stat-card:last-child {
            border-right: none;
        }

        .wf-stat-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .wf-stat-value {
            line-height: 1.2;
        }

        .wf-stat-big {
            font-size: 26px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .wf-stat-small {
            font-size: 15px;
            font-weight: 400;
            color: var(--text-secondary);
        }

        .wf-stat-value--text {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            word-break: break-all;
        }

        .wf-stat-link {
            color: var(--accent-color);
            text-decoration: none;
            cursor: pointer;
        }

        .wf-stat-link:hover {
            text-decoration: underline;
        }

        /* ── Details grid ── */
        .wf-details {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 2px;
            overflow: hidden;
        }

        .wf-detail-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 1px solid var(--border-color);
        }

        .wf-detail-row:last-child {
            border-bottom: none;
        }

        .wf-detail-cell {
            padding: 12px 16px;
        }

        .wf-detail-cell:first-child {
            border-right: 1px solid var(--border-color);
        }

        .wf-detail-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            margin-bottom: 4px;
        }

        .wf-detail-value {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            word-break: break-word;
        }

        /* ── Workflow stepper ── */
        .wf-stepper-container {
            display: flex;
            align-items: flex-start;
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .wf-scol {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            min-width: 140px;
            padding: 0 8px;
        }

        /* connecting line between dots */
        .wf-scol:not(.wf-scol--last)::after {
            content: '';
            position: absolute;
            top: 20px;
            left: calc(50% + 20px);
            width: calc(100% - 40px);
            height: 2px;
            background: var(--border-color);
        }

        .wf-scol--done:not(.wf-scol--last)::after {
            background: var(--text-secondary);
        }

        /* ── Step dot ── */
        .wf-sdot {
            position: relative;
            z-index: 1;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 2px solid var(--border-color);
            background: #ffffff;
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .wf-sdot--completed {
            background: var(--text-primary);
            border-color: var(--text-primary);
            color: #ffffff;
        }

        .wf-sdot--current {
            border-color: var(--accent-color);
            color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.12);
        }

        .wf-sdot--rejected {
            background: #fef2f2;
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

        .wf-sdot-icon {
            width: 16px;
            height: 16px;
        }

        .wf-sdot-num {
            font-size: 14px;
            font-weight: 600;
        }

        /* ── Step name ── */
        .wf-sname {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-top: 10px;
            text-align: center;
        }

        /* ── Assignees ── */
        .wf-assignees {
            margin-top: 10px;
            width: 100%;
            border: 1px solid var(--border-color);
            border-radius: 2px;
            overflow: hidden;
        }

        .wf-assignee {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 8px;
            font-size: 12px;
            border-bottom: 1px solid var(--border-color);
            background: #ffffff;
        }

        .wf-assignee:last-child {
            border-bottom: none;
        }

        .wf-aind {
            width: 7px;
            height: 7px;
            border-radius: 2px;
            flex-shrink: 0;
        }

        .wf-aind--active {
            background: var(--success-color);
        }

        .wf-aind--inactive {
            background: var(--text-secondary);
        }

        .wf-aname {
            color: var(--text-primary);
            font-weight: 500;
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .wf-aaction {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.04em;
            flex-shrink: 0;
        }

        .wf-aaction--submit,
        .wf-aaction--approve {
            color: var(--success-color);
        }

        .wf-aaction--return,
        .wf-aaction--cancel,
        .wf-aaction--reject {
            color: var(--danger-color);
        }

        .wf-aaction--none {
            color: var(--text-secondary);
        }

        /* ── Responsive ── */
        @@media (max-width: 640px) {
            .wf-card {
                padding: 20px;
            }

            .wf-stats-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .wf-stat-card:nth-child(2) {
                border-right: none;
            }

            .wf-stat-card:nth-child(1),
            .wf-stat-card:nth-child(2) {
                border-bottom: 1px solid var(--border-color);
            }

            .wf-scol {
                min-width: 120px;
            }
        }
    </style>
}

<div class="container-fluid">
    <div class="jp-minimal-header">
        <h2>Application Report</h2>
        <p>View and manage application reports using the grid below.</p>
    </div>
    <div class="grid-wrapper">
        <div id="gridApplicationReport"></div>
    </div>
</div>

@section Scripts {
    <partial name="_GridScripts" />
    <script src="~/js/grids/reports/application-report-config.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function () {
            const grid = GridFactory.createGrid(ApplicationReportGridConfig);
        });
    </script>
}